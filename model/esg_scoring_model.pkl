import pandas as pd
import joblib

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import (
    mean_absolute_error,
    mean_squared_error,
    r2_score
)

# =====================================================
# LOAD DATASET
# =====================================================

df = pd.read_csv("data/esg_benchmark_dataset.csv")

print("\nDataset Shape:", df.shape)
print(df.head())

# =====================================================
# TARGET COLUMN
# =====================================================

TARGET_COLUMN = "ESG_Score"

# =====================================================
# FEATURES & TARGET
# =====================================================

X = df.drop(columns=[TARGET_COLUMN])
y = df[TARGET_COLUMN]

# Convert categorical columns if any
X = pd.get_dummies(X, drop_first=True)

# =====================================================
# TRAIN TEST SPLIT
# =====================================================

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)

# =====================================================
# FEATURE SCALING
# =====================================================

scaler = StandardScaler()

X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

# =====================================================
# ESG SCORING MODEL
# =====================================================

model = RandomForestRegressor(
    n_estimators=300,
    max_depth=10,
    min_samples_split=5,
    min_samples_leaf=2,
    random_state=42,
    n_jobs=-1
)

model.fit(X_train_scaled, y_train)

# =====================================================
# PREDICTIONS
# =====================================================

y_pred = model.predict(X_test_scaled)

# =====================================================
# EVALUATION
# =====================================================

mae = mean_absolute_error(y_test, y_pred)
mse = mean_squared_error(y_test, y_pred)
rmse = mse ** 0.5
r2 = r2_score(y_test, y_pred)

print("\n================================")
print("ESG SCORING MODEL PERFORMANCE")
print("================================")

print(f"MAE  : {mae:.4f}")
print(f"MSE  : {mse:.4f}")
print(f"RMSE : {rmse:.4f}")
print(f"R²   : {r2:.4f}")

# =====================================================
# SAVE MODEL
# =====================================================

joblib.dump(model, "models/esg_scoring_model.pkl")
joblib.dump(scaler, "models/esg_scaler.pkl")

print("\nModel Saved Successfully!")
print("Saved at: models/esg_scoring_model.pkl")
print("Saved at: models/esg_scaler.pkl")
