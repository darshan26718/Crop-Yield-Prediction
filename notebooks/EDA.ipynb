import pandas as pd
import numpy as np

import matplotlib.pyplot as plt
import seaborn as sns

import plotly.express as px
import plotly.graph_objects as go

from sklearn.preprocessing import LabelEncoder

sns.set_style("whitegrid")

# ============================================================
# LOAD DATASET
# ============================================================

df = pd.read_csv("../data/data_season.csv")

print("=" * 60)
print("DATASET LOADED SUCCESSFULLY")
print("=" * 60)

# ============================================================
# BASIC INFORMATION
# ============================================================

print("\nDataset Shape:")
print(df.shape)

print("\nDataset Columns:")
print(df.columns.tolist())

print("\nDataset Info:")
print(df.info())

# ============================================================
# FIRST 5 RECORDS
# ============================================================

print("\nFirst Five Records")
print(df.head())

# ============================================================
# LAST 5 RECORDS
# ============================================================

print("\nLast Five Records")
print(df.tail())

# ============================================================
# DESCRIPTIVE STATISTICS
# ============================================================

print("\nStatistical Summary")
print(df.describe())

# ============================================================
# MISSING VALUES
# ============================================================

print("\nMissing Values")
print(df.isnull().sum())

plt.figure(figsize=(12,6))

sns.heatmap(
    df.isnull(),
    cbar=False,
    yticklabels=False
)

plt.title("Missing Values Heatmap")
plt.show()

# ============================================================
# DUPLICATE RECORDS
# ============================================================

duplicates = df.duplicated().sum()

print("\nDuplicate Records:", duplicates)

# ============================================================
# UNIQUE VALUES
# ============================================================

print("\nUnique Values")

for col in df.columns:
    print(f"\n{col}")
    print(df[col].nunique())

# ============================================================
# TARGET VARIABLE ANALYSIS
# ============================================================

plt.figure(figsize=(10,5))

sns.histplot(
    df["yeilds"],
    kde=True
)

plt.title("Yield Distribution")
plt.xlabel("Yield")
plt.ylabel("Frequency")

plt.show()

# ============================================================
# CROP DISTRIBUTION
# ============================================================

plt.figure(figsize=(15,6))

sns.countplot(
    x=df["Crops"],
    order=df["Crops"].value_counts().index
)

plt.xticks(rotation=90)

plt.title("Crop Distribution")

plt.show()

# ============================================================
# SEASON DISTRIBUTION
# ============================================================

fig = px.pie(
    df,
    names="Season",
    title="Season Distribution"
)

fig.show()

# ============================================================
# LOCATION DISTRIBUTION
# ============================================================

plt.figure(figsize=(14,6))

sns.countplot(
    x=df["Location"],
    order=df["Location"].value_counts().index
)

plt.xticks(rotation=90)

plt.title("Location Distribution")

plt.show()

# ============================================================
# AVERAGE YIELD BY CROP
# ============================================================

crop_yield = (
    df.groupby("Crops")["yeilds"]
    .mean()
    .sort_values(ascending=False)
)

print("\nTop Crop Yield")
print(crop_yield.head(10))

plt.figure(figsize=(15,6))

crop_yield.head(10).plot(
    kind="bar"
)

plt.title("Top 10 Crops by Average Yield")

plt.show()

# ============================================================
# AVERAGE YIELD BY LOCATION
# ============================================================

location_yield = (
    df.groupby("Location")["yeilds"]
    .mean()
    .sort_values(ascending=False)
)

print(location_yield.head(10))

fig = px.bar(
    x=location_yield.head(10).index,
    y=location_yield.head(10).values,
    labels={
        "x":"Location",
        "y":"Yield"
    },
    title="Top Locations by Yield"
)

fig.show()

# ============================================================
# SEASONAL YIELD ANALYSIS
# ============================================================

season_yield = (
    df.groupby("Season")["yeilds"]
    .mean()
    .sort_values(ascending=False)
)

print(season_yield)

fig = px.bar(
    x=season_yield.index,
    y=season_yield.values,
    labels={
        "x":"Season",
        "y":"Yield"
    },
    title="Average Yield by Season"
)

fig.show()

# ============================================================
# SOIL TYPE ANALYSIS
# ============================================================

soil_yield = (
    df.groupby("Soil type")["yeilds"]
    .mean()
    .sort_values(ascending=False)
)

print("\nYield by Soil Type")
print(soil_yield)

plt.figure(figsize=(12,5))

soil_yield.plot(
    kind="bar"
)

plt.title("Yield by Soil Type")

plt.show()

# ============================================================
# IRRIGATION ANALYSIS
# ============================================================

irrigation_yield = (
    df.groupby("Irrigation")["yeilds"]
    .mean()
    .sort_values(ascending=False)
)

print(irrigation_yield)

plt.figure(figsize=(10,5))

irrigation_yield.plot(
    kind="bar"
)

plt.title("Yield by Irrigation")

plt.show()

# ============================================================
# RAINFALL VS YIELD
# ============================================================

fig = px.scatter(
    df,
    x="Rainfall",
    y="yeilds",
    color="Season",
    hover_data=["Crops"],
    title="Rainfall vs Yield"
)

fig.show()

# ============================================================
# TEMPERATURE VS YIELD
# ============================================================

fig = px.scatter(
    df,
    x="Temperature",
    y="yeilds",
    color="Season",
    hover_data=["Crops"],
    title="Temperature vs Yield"
)

fig.show()

# ============================================================
# HUMIDITY VS YIELD
# ============================================================

fig = px.scatter(
    df,
    x="Humidity",
    y="yeilds",
    color="Season",
    hover_data=["Crops"],
    title="Humidity vs Yield"
)

fig.show()

# ============================================================
# AREA VS YIELD
# ============================================================

fig = px.scatter(
    df,
    x="Area",
    y="yeilds",
    color="Crops",
    title="Area vs Yield"
)

fig.show()

# ============================================================
# PRICE VS YIELD
# ============================================================

fig = px.scatter(
    df,
    x="price",
    y="yeilds",
    color="Season",
    title="Price vs Yield"
)

fig.show()

# ============================================================
# BOXPLOT OF YIELD
# ============================================================

plt.figure(figsize=(12,6))

sns.boxplot(
    x="Season",
    y="yeilds",
    data=df
)

plt.title("Yield Distribution Across Seasons")

plt.show()

# ============================================================
# OUTLIER DETECTION
# ============================================================

plt.figure(figsize=(12,4))

sns.boxplot(
    x=df["yeilds"]
)

plt.title("Yield Outlier Detection")

plt.show()

# ============================================================
# CORRELATION ANALYSIS
# ============================================================

numeric_df = df.select_dtypes(include=np.number)

corr = numeric_df.corr()

print(corr)

plt.figure(figsize=(10,8))

sns.heatmap(
    corr,
    annot=True,
    cmap="coolwarm"
)

plt.title("Correlation Heatmap")

plt.show()

# ============================================================
# PAIRPLOT
# ============================================================

sns.pairplot(
    df[
        [
            "Area",
            "Rainfall",
            "Temperature",
            "Humidity",
            "price",
            "yeilds"
        ]
    ]
)

plt.show()

# ============================================================
# TOP INSIGHTS
# ============================================================

best_crop = (
    df.groupby("Crops")["yeilds"]
    .mean()
    .idxmax()
)

best_location = (
    df.groupby("Location")["yeilds"]
    .mean()
    .idxmax()
)

best_season = (
    df.groupby("Season")["yeilds"]
    .mean()
    .idxmax()
)

print("\n" + "=" * 60)

print("TOP INSIGHTS")

print("=" * 60)

print(f"Best Crop       : {best_crop}")

print(f"Best Location   : {best_location}")

print(f"Best Season     : {best_season}")

print(f"Average Yield   : {df['yeilds'].mean():.2f}")

print(f"Average Rainfall: {df['Rainfall'].mean():.2f}")

print(f"Average Temp    : {df['Temperature'].mean():.2f}")

# ============================================================
# CONCLUSION
# ============================================================

print("\n" + "=" * 60)

print("EDA COMPLETED SUCCESSFULLY")

print("=" * 60)

print("""
